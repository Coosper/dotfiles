{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "notification-window-preferred-output": "DP-1",
  "control-center-preferred-output": "DP-1",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "control-center-width": 380,
  "control-center-height": 1440,
  "notification-window-width": 380,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "transition-time": 150,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "image-visibility": "when-available",
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "volume",
    "buttons-grid",
    "title",
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰆴 Clear"
    },
    "dnd": {
      "text": "FUCKOFF"
    },
    "mpris": {
      "blacklist": [
        "spotify.instance1",
        "Spotify",
        "playerctld"
      ],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false,
      "image-size": 56,
      "image-radius": 0
    },
    "volume": {
      "label": "VOL",
      "show-per-app": false
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "⏻ POWER",
	  "command": "bash -c '/home/coosper/.dotfiles/AGS/launch-powermenu.sh'"
        },
        {
          "label": "󰋋 OUTPUT",
          "command": "~/.dotfiles/waybar/waybar/modules/audio-toggle.sh"
        }
      ]
    }
  }
}